# Configuración de variables de entorno para Frontend ALZA (SIFTC)
# Copiar este archivo como .env para desarrollo local

# Interruptor de simulación:
# 'true'  -> Usa datos simulados en memoria (sin requerir conexión al servidor)
# 'false' -> Se conecta al servicio de la API desplegado en Render
VITE_USE_MOCK=false

# URL base del servidor de la API desplegado en Render
VITE_API_URL=https://siftc.onrender.com

# Prefijo oficial de los endpoints según docs/api/openapi-v1.json
VITE_API_PREFIX=/api/v1
