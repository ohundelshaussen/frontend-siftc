# Configuración de variables de entorno para Frontend ALZA
# Copiar este archivo como .env para desarrollo local

# Interruptor de simulación:
# 'true'  -> Usa datos simulados en memoria (sin requerir backend)
# 'false' -> Se conecta a la API real en C# / .NET 10
VITE_USE_MOCK=true

# URL base del backend:
# - Con Docker Compose: http://localhost:7123
# - Con ejecución nativa 'dotnet run': http://localhost:5057
# - Microservicio Python: http://localhost:8000
VITE_API_URL=http://localhost:7123

# Prefijo oficial de los endpoints
VITE_API_PREFIX=/api/v1
